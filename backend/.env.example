# Copy to .env. Only the first four are required; everything else runs in test mode when left empty.
MONGODB_URI=mongodb://localhost:27017/mediconnect
REDIS_URL=redis://localhost:6379
# Long random strings, different from each other: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

PORT=5000
# Where email links point (the site's public address).
APP_URL=http://localhost:5173
# Run the notification worker inside the API process (handy on a single free-tier server).
RUN_WORKER_IN_API=false

# Razorpay. Leave KEY_ID empty for test mode: a "Pay (test mode)" button marks bookings paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio SMS. Leave empty to log messages instead of sending them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email, e.g. smtp://user:pass@smtp.mailtrap.io:2525. Leave empty to log emails (with their links) instead.
SMTP_URL=
MAIL_FROM=MediConnect <no-reply@mediconnect.app>
